# ===== D'Piero POS — backend/.env.example =====
# Copia este archivo como backend/.env y complétalo con tus valores reales.
# NUNCA subas el archivo .env con valores reales a un repositorio.

# Entorno de ejecución: development | production
NODE_ENV=development

# Puerto HTTP del backend
PORT=4000

# URL del frontend (única permitida por CORS en producción)
FRONTEND_URL=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=pos_app
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA
DB_NAME=pos_project

# JWT (firma HS256) — mínimo 24 caracteres, genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_ALEATORIO_DE_48_BYTES
JWT_EXPIRES=1h

# Gmail SMTP (opcional)
# Sin estas variables, los códigos de recuperación se imprimen en la consola del backend.
# Usa una "contraseña de aplicación" de Google, NO la contraseña de tu cuenta.
SMTP_USER=
SMTP_PASS=
